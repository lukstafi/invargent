datatype Node : num * num * num

datacons Step : ∀i, j,
   k[i ≤ k + 1].Node ((7/9) i + (-8/9) j, (4/9) i + (7/9) j, (65/64) k) ⟶
   Node (i, j, k)

val node :
   ∀n, k, i, j, m, l, n1, k1, i1, j1, m1, l1, n2[n ≤ 1 + i ∧ -i ≤ 0 ∧
   n + -j ≤ 0 ∧ -n + -j ≤ 0 ∧ (-24/17) k + -m ≤ 0 ∧ (24/17) k + -m ≤ 0 ∧
   (17/81) n + (-112/81) k + (-4225/4096) i + -1 ≤ 0 ∧
   (7/9) n + (-8/9) k + (-65/64) i + -1 ≤ 0 ∧
   (-863/1441) j + (-1156/1441) m + l = 0 ∧
   (-1152/1441) j + (863/1441) m + -n1 ≤ 0 ∧
   (1152/1441) j + (-863/1441) m + -n1 ≤ 0 ∧
   (-4319/4897) l + (-2312/4897) n1 + k1 = 0 ∧
   (-2304/4897) l + (4319/4897) n1 + -i1 ≤ 0 ∧
   (2304/4897) l + (-4319/4897) n1 + -i1 ≤ 0 ∧
   (-18143/18721) k1 + (-4624/18721) i1 + j1 = 0 ∧
   (-4608/18721) k1 + (18143/18721) i1 + -m1 ≤ 0 ∧
   (4608/18721) k1 + (-18143/18721) i1 + -m1 ≤ 0 ∧
   (-73439/74017) j1 + (-9248/74017) m1 + l1 = 0 ∧
   (-9216/74017) j1 + (73439/74017) m1 + -n2 ≤ 0 ∧
   (9216/74017) j1 + (-73439/74017) m1 + -n2 ≤ 0 ∧
   (-9216/74017) l1 + (73439/74017) n2 ≤ 0 ∧
   (-577/72) i + l1 + (289/4608) n2 ≤ 0 ∧
   (-274625/262144) i + l1 + (289/4608) n2 + -1 ≤ 0]. Node (n, k, i)

val root : Node ((-51/25), 0, 1)

val ray : ∀i[0 ≤ i]. Node ((-26/25) i, 0, i + 1)

datatype Hex : num * num * num

datacons Fork : ∀i, j,
   k[i ≤ k + 1].Hex ((1/2) i + (-3/2) j, (1/2) i + (1/2) j, (6/5) k) *
   Hex ((1/2) i + (3/2) j, (-1/2) i + (1/2) j, 9 k) ⟶ Hex (i, j, k)

val hex :
   ∀n, k, i[n + -i + -1 ≤ 0 ∧ (1/2) n + (-3/2) k + (-6/5) i + -1 ≤ 0 ∧
   (-1/2) n + (-3/2) k + (-36/25) i + -1 ≤ 0 ∧ -n + (-216/125) i + -1 ≤ 0 ∧
   (-1/2) n + (3/2) k + (-1296/625) i + -1 ≤ 0 ∧
   (1/2) n + (3/2) k + (-7776/3125) i + -1 ≤ 0 ∧ -i ≤ 0]. Hex (n, k, i)

val alias :
   ∀n, k, i[n + -i + -1 ≤ 0 ∧ (1/2) n + (-3/2) k + (-6/5) i + -1 ≤ 0 ∧
   (-1/2) n + (-3/2) k + (-36/25) i + -1 ≤ 0 ∧ -n + (-216/125) i + -1 ≤ 0 ∧
   (-1/2) n + (3/2) k + (-1296/625) i + -1 ≤ 0 ∧
   (1/2) n + (3/2) k + (-7776/3125) i + -1 ≤ 0 ∧ -i ≤ 0]. Hex (n, k, i)

val edge : Hex (1, 0, 0)

datatype Held : num * num * num

datacons Balance : ∀i, j,
   k[i ≤ k + 1].Held ((3/5) i + (-4/5) j, (4/5) i + (3/5) j, k) *
   Held (i, j, 2 k) ⟶ Held (i, j, k)

val held : ∀n, k, i[n = 0 ∧ -k = 0 ∧ -i ≤ 0 ∧ n ≤ 1 + i]. Held (n, k, i)

val axis : ∀n[0 ≤ n]. Held (0, 0, n)
