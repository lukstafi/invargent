datatype Nat
datacons Z : Nat
datacons S : Nat ⟶ Nat

external let observe : ∀i. Num i → Bool = "fun v -> print_endline (string_of_int v); true"
let rec run : ∀k,n[6≤n ∧ 1≤k ∧ k≤n ∧ min(k + -2,4 + -k)≤0]. Num n → Nat →
  ∃l[-5≤l ∧ l≤n ∧ min(l+5,1 + -l)≤0 ∧ min(l+1 + -k,k+1 + -l)≤0 ∧ min(l+4 + -k,k + -2 + -l)≤0]. Num l =
  fun size -> efunction
  | Z -> (-5)
  | S d -> let prior = run size d in
           (match prior with r when 1 <= r && r <= size -> True | _ -> (-5))
test (let p = run 9 (S (S Z)) in observe p)
