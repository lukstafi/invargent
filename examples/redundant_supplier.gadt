datatype Nat
datacons Z : Nat
datacons S : Nat ⟶ Nat

datatype StepResult : num * num * num * num
datacons B : ∀i, j, m, n, k [j≤k ∧ k≤n+1 ∧ k≤m+19 ∧ k≤max(n+1,j+i)]. Num k ⟶ StepResult (i,j,m,n)
datacons Floor : ∀i, j, m, n. StepResult (i,j,m,n)
external let step : ∀i, j, m, n [j≤n ∧ n≤max(m+20,j)]. Num i → Num j → Num m → Num n → StepResult (i,j,m,n) =
  "fun f j m n -> assert (j <= n && n <= max (m+20) j); if m+19 <= j then Floor else B (min (n+1) (m+19))"

let rec climb e d j m = efunction
  | Z -> j
  | S t -> let r = climb e d (j+(-1 * e)) (m+d) t in
           (ematch step e j m r with B u -> u | Floor -> j)

test (let r = climb (0) (-1) 3 (-18) (S (S Z)) in let r = climb (-1) (1) 3 (-16) (S (S Z)) in True)
