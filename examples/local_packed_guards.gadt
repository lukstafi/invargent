datatype Marker
datacons Mark : Marker
datatype Cargo
datacons Box : Cargo
datatype Tag : type * type * type * type
datacons First : ∀a. a ⟶ Tag (a, Marker, Marker, Marker)
datacons Second : ∀a. a ⟶ Tag (Marker, a, Marker, Marker)
datacons Third : ∀a. a ⟶ Tag (Marker, Marker, a, Marker)
datacons Fourth : ∀a. a ⟶ Tag (Marker, Marker, Marker, a)
datatype Nat
datacons Z : Nat
datacons S : Nat ⟶ Nat

external let same : ∀a. a → a → Bool =
  "fun a b -> assert (a = b); true"

datatype Seed
datacons Pick : ∀i[i≤0]. Num i ⟶ Seed
external let observed : ∀i. Num i → Num i =
  "let calls = ref 0 in fun n -> if n = 73 then assert (!calls = 1) else incr calls; n"
external let note : ∀i. Num i → Bool = "let ticks = ref 0 in fun n -> if n = 73 then assert (!ticks = 1) else incr ticks; true"
external let seed : Seed = "Pick 0"

let rec f t = efunction
  | Z -> let z = (match t with First x -> x | Second x -> x | Third x -> x | Fourth x -> x) in (z,z)
  | S n -> f t n

test (let rec relay n = efunction
        | Z -> observed n
        | S d -> relay n d in
      match seed with
  | Pick n ->
    let returned = relay n (S Z) in
    let ok0 = (match returned with r when 1 <= r ->
      let ok = (let (x,y) = f (Third Box) (S Z) in same x Box) in
      let (x,y) = f (First Box) (S Z) in same x Box
     | _ -> True) in
    let ok1 = (match returned with r when 0 <= r -> note r | _ -> False) in
    let ok2 = (match returned with r when 1 <= r ->
      let ok = (let (x,y) = f (Third Box) (S Z) in same x Box) in
      let (x,y) = f (First Box) (S Z) in same x Box
     | _ -> True) in True)

let checked = observed 73
let ticks = note 73
