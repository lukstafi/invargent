datatype Nat

datacons Z : Nat

datacons S : Nat ⟶ Nat

datatype StepResult : num * num

datacons B : ∀k, m, n[m ≤ k ∧ k ≤ n + 1 ∧ k ≤ m + 19].Num k ⟶
   StepResult (m, n)

external val step :
   ∀m, n[m ≤ n ∧ n ≤ m + 20]. Num m → Num n → StepResult (m, n)

val climb : ∀n. Num n → Nat → ∃k[k ≤ n + 20 ∧ n ≤ k].Num k
