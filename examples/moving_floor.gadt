datatype Nat
datacons Z : Nat
datacons S : Nat ⟶ Nat

datatype StepResult : num * num * num
datacons B : ∀j, m, n, k [j≤k ∧ k≤n+1 ∧ k≤m+19]. Num k ⟶ StepResult (j,m,n)
datacons Floor : ∀j, m, n. StepResult (j,m,n)
external let step : ∀j, m, n [j≤n ∧ n≤max(m+20,j)]. Num j → Num m → Num n → StepResult (j,m,n) =
  "fun j m n -> assert (j <= n && n <= max (m+20) j); if m+19 <= j then Floor else B (min (n+1) (m+19))"

let rec climb j m = efunction
  | Z -> j
  | S t -> let r = climb (j+ 1) (m+ 1) t in
           (ematch step j m r with B u -> u | Floor -> j)

let witness = climb 3 (-16) (S (S Z))
