datatype Node : num * num * num

datacons Step : ∀i, j,
   k[i ≤ k + 1].Node ((7/9) i + (-8/9) j, (4/9) i + (7/9) j, (65/64) k) ⟶
   Node (i, j, k)

val node :
   ∀n, k, i, j, m, l, n1, k1, i1, j1, m1, l1, n2[n ≤ 1 + i ∧ -i ≤ 0 ∧
   n + -j ≤ 0 ∧ -n + -j ≤ 0 ∧ (-24/17) k + -m ≤ 0 ∧ (24/17) k + -m ≤ 0 ∧
   (-863/1441) j + (-1156/1441) m + l = 0 ∧
   (-1152/1441) j + (863/1441) m + -n1 ≤ 0 ∧
   (1152/1441) j + (-863/1441) m + -n1 ≤ 0 ∧
   (-4319/4897) l + (-2312/4897) n1 + k1 = 0 ∧
   (-2304/4897) l + (4319/4897) n1 + -i1 ≤ 0 ∧
   (2304/4897) l + (-4319/4897) n1 + -i1 ≤ 0 ∧
   (-18143/18721) k1 + (-4624/18721) i1 + j1 = 0 ∧
   (-4608/18721) k1 + (18143/18721) i1 + -m1 ≤ 0 ∧
   (4608/18721) k1 + (-18143/18721) i1 + -m1 ≤ 0 ∧
   (-73439/74017) j1 + (-9248/74017) m1 + l1 = 0 ∧
   (-9216/74017) j1 + (73439/74017) m1 + -n2 ≤ 0 ∧
   (9216/74017) j1 + (-73439/74017) m1 + -n2 ≤ 0 ∧
   (-9216/74017) l1 + (73439/74017) n2 ≤ 0 ∧
   (-577/144) i + l1 + (289/4608) n2 ≤ 0 ∧
   (-65/64) i + l1 + (289/4608) n2 + -1 ≤ 0]. Node (n, k, i)

val alias :
   ∀n, k, i, j, m, l, n1, k1, i1, j1, m1, l1, n2[n ≤ 1 + i ∧ -i ≤ 0 ∧
   n + -j ≤ 0 ∧ -n + -j ≤ 0 ∧ (-24/17) k + -m ≤ 0 ∧ (24/17) k + -m ≤ 0 ∧
   (-863/1441) j + (-1156/1441) m + l = 0 ∧
   (-1152/1441) j + (863/1441) m + -n1 ≤ 0 ∧
   (1152/1441) j + (-863/1441) m + -n1 ≤ 0 ∧
   (-4319/4897) l + (-2312/4897) n1 + k1 = 0 ∧
   (-2304/4897) l + (4319/4897) n1 + -i1 ≤ 0 ∧
   (2304/4897) l + (-4319/4897) n1 + -i1 ≤ 0 ∧
   (-18143/18721) k1 + (-4624/18721) i1 + j1 = 0 ∧
   (-4608/18721) k1 + (18143/18721) i1 + -m1 ≤ 0 ∧
   (4608/18721) k1 + (-18143/18721) i1 + -m1 ≤ 0 ∧
   (-73439/74017) j1 + (-9248/74017) m1 + l1 = 0 ∧
   (-9216/74017) j1 + (73439/74017) m1 + -n2 ≤ 0 ∧
   (9216/74017) j1 + (-73439/74017) m1 + -n2 ≤ 0 ∧
   (-9216/74017) l1 + (73439/74017) n2 ≤ 0 ∧
   (-577/144) i + l1 + (289/4608) n2 ≤ 0 ∧
   (-65/64) i + l1 + (289/4608) n2 + -1 ≤ 0]. Node (n, k, i)

val root : Node (2, 0, 1)

val box : ∀i, j[-1 ≤ i ∧ i ≤ 1 ∧ -1 ≤ j ∧ j ≤ 1]. Node (i, j, 1)

val ray : ∀i, k[1 ≤ k ∧ -k ≤ i ∧ i ≤ k]. Node (i, 0, k)
