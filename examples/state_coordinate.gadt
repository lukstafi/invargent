datatype State : num
datacons A : State 0
datacons B : State 1
datatype Nat
datacons Z : Nat
datacons S : Nat ⟶ Nat
external let small : ∀i[i≤1]. Num i → Bool = "fun r -> assert (r <= 1); true"
let rec run state = efunction
  | Z -> (match state with A -> 0 | B -> 1)
  | S d -> (match state with A -> 0 | B -> let prior = run B d in
               (match prior with r when r <= 0 -> 2 | _ -> 1))
test (let ok = (let a = run A (S Z) in small a) in let b = run B (S (S Z)) in small b)
