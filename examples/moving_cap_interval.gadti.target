datatype Nat

datacons Z : Nat

datacons S : Nat ⟶ Nat

datatype StepResult : num * num * num

datacons B : ∀j, k, m, n[j ≤ k ∧ k ≤ n + 1 ∧ k ≤ m + 18].
   Num k ⟶ StepResult (j, m, n)

datacons Floor : ∀j, m, n. StepResult (j, m, n)

external val step :
   ∀j, m, n[j ≤ n ∧ n≤max (m + 20, j)].
   Num j → Num m → Num n → StepResult (j, m, n)

val climb :
   ∀i, k, n[i ≤ 2 ∧ 1 ≤ i ∧ k ≤ n + 19].
   Num i → Num k → Num n → Nat → ∃i[k ≤ i ∧
     i≤max (k, n + 18)].Num i

val lower : ∃n[19 ≤ n ∧ n≤max (19, 18)].Num n

val upper : ∃n[19 ≤ n ∧ n≤max (19, 18)].Num n
