datatype Gate : num * num
datacons East : Gate (1,0)
datacons North : Gate (0,1)
datacons Bad : ∀i,j[i≤0 ∧ j≤0]. Gate (i,j)
let accept = function East -> True | North -> True | Bad -> assert false
let east = accept East
let north = accept North

datatype Band : num * num
datacons A : Band (1,0)
datacons B : Band (0,1)
datacons Below : ∀i,j[i≤0 ∧ j≤0]. Band (i,j)
datacons Above : ∀i,j[1≤i ∧ 1≤j]. Band (i,j)
let inside = function A -> True | B -> True | Below -> assert false | Above -> assert false
let a = inside A
let b = inside B

datatype Track : num * num
datacons Fixed : Track (3,3)
datacons Along : ∀k[0≤k ∧ k≤1]. Track (-k,-2 k)
datacons First : Track (0,-1)
datacons Second : Track (2,2)
let follow = function Fixed -> True | Along -> True | First -> assert false | Second -> assert false
let fixed = follow Fixed
let along = follow Along

datatype Slit : num * num
datacons Origin : Slit (0,0)
datacons Tip : ∀j[0≤j ∧ j≤2]. Slit (2,j)
datacons Shut : Slit (1,0)
datacons Wall : ∀j[1≤1048576 j ∧ j≤1]. Slit (1,j)
let pass = function Origin -> True | Tip -> True | Shut -> assert false | Wall -> assert false
let origin = pass Origin
let tip = pass Tip
