datatype Orbit : num * num * num * num * num * num
datacons Fork : ∀i,j,k,l,m,n[1≤i+l+n]. Orbit (i + j + 1/4 l,1/4 j + 1/8 l,1/4 k + 1/8 m,1/16 l,1/16 m,1/16 n) * Orbit (i + 5/4 j + 25/64 l,1/16 j + 5/128 l,1/4 k + 5/32 m,1/256 l,1/64 m,1/16 n) ⟶ Orbit (i,j,k,l,m,n)
let rec ring = Fork (ring,ring)
datatype Seen
datacons Observe : ∀n[1≤n]. Orbit (0,0,0,n,n,n) ⟶ Seen
let observed = Observe ring
let sharp : Orbit (0,0,0,8/3,8/3,8/3) = ring
let earlier : Orbit (-3,3,0,3,0,1) = ring

datatype Decay : num * num * num
datacons Shrink : ∀i,j,k[i+j+k≤0]. Decay (1/2 i,1/3 j,1/5 k) ⟶ Decay (i,j,k)
let rec decay = Shrink decay
let first : Decay (-1,0,1) = decay
let second : Decay (0,-1,0) = decay
let middle : Decay (-1/2,-1/2,1/2) = decay
