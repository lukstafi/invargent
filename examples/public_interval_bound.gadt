datatype State : num
datacons A : State 0
datacons B : State 1
datacons C : State 2
datatype Nat
datacons Z : Nat
datacons S : Nat ⟶ Nat
external let accept : ∀i[i≤9]. Num i → Bool = "fun n -> assert (n <= 9); true"

let base : ∀i. State i → Num (4 i + 1) = function A -> 1 | B -> 5 | C -> 9

let line : ∀i. State i → Num (6 i + (-1)) = function A -> (-1) | B -> 5 | C -> 11

let rec run : ∀i,k,l[k=min(l, 4 i+1) ∧ 0≤i ∧ i≤2 ∧ min(i,1 + -i)≤0 ∧ min(i + (-1),2 + -i)≤0 ∧ k≤4 i+1 ∧ 4 i+1≤k+2].
  State i → Num l → Nat → ∃j[k≤j ∧ j≤k+2]. Num j = fun s bound -> efunction
  | Z -> base s
  | S d -> let prior = run s (line s) d in
           (match prior with r when 2 <= r && r <= 4 -> True | _ -> base s)
test (let a = (let p = run A 1 (S Z) in accept p) in let b = (let p = run B 3 (S (S Z)) in accept p) in let p = run C 7 (S Z) in accept p)
