datatype State : num

datacons A : State 0

datacons B : State 1

datacons C : State 2

datacons D : State 3

datatype Nat

datacons Z : Nat

datacons S : Nat ⟶ Nat

external val accept : ∀i[i ≤ 13]. Num i → Bool

val base : ∀n. State n → Num (4 n + 1)

val run :
   ∀k, n[k ≤ 3 ∧ 0 ≤ n + 1 ∧ n ≤ 13 ∧ 4 k ≤ n + 1 ∧ 0 ≤ k ∧ n ≤ 4 k + 1 ∧
   min||max (k + -1, -k + 2) ∧ min||max (k, -k + 1) ∧
   min||max (k + -2, -k + 3)]. State k → Nat → ∃j[n ≤ j ∧ j ≤ n + 2].Num j
