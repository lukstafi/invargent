datatype Node : num * num * num
datacons Step : ∀i,j,k[i≤1+k]. Node (7/9 i + -8/9 j,4/9 i + 7/9 j,65/64 k) ⟶ Node (i,j,k)
let rec node = Step node
let alias = node
let root : Node (2,0,1) = alias
let box : ∀i,j[-1≤i ∧ i≤1 ∧ -1≤j ∧ j≤1]. Node (i,j,1) = alias
let ray : ∀i,k[1≤k ∧ -k≤i ∧ i≤k]. Node (i,0,k) = alias
