datatype Curve : num * num

datacons Step : ∀i, j[0 ≤ j].Curve (i + -1, 1 + j + -2 i) ⟶ Curve (i, j)

val curve :
   ∀n, k, i, j, m, l, n1, k1, i1, j1, m1, l1[n + -1024 ≤ 0 ∧
   -n + -i + 512 ≤ 0 ∧ n + -i + -512 ≤ 0 ∧ -i + -j + 256 ≤ 0 ∧
   i + -j + -256 ≤ 0 ∧ -j + -m + 128 ≤ 0 ∧ j + -m + -128 ≤ 0 ∧
   -m + -l + 64 ≤ 0 ∧ m + -l + -64 ≤ 0 ∧ -l + -n1 + 32 ≤ 0 ∧
   l + -n1 + -32 ≤ 0 ∧ -n1 + -k1 + 16 ≤ 0 ∧ n1 + -k1 + -16 ≤ 0 ∧
   -k1 + -i1 + 8 ≤ 0 ∧ k1 + -i1 + -8 ≤ 0 ∧ -i1 + -j1 + 4 ≤ 0 ∧
   i1 + -j1 + -4 ≤ 0 ∧ -j1 + -m1 + 2 ≤ 0 ∧ j1 + -m1 + -2 ≤ 0 ∧
   -m1 + -l1 + 1 ≤ 0 ∧ m1 + -l1 + -1 ≤ 0 ∧
   1024 n + -k + 512 i + 256 j + 128 m + 64 l + 32 n1 + 16 k1 + 8 i1 + 4 j1 +
     2 m1 + 2 l1 + -349526 ≤ 0 ∧
   1024 n + -k + 512 i + 256 j + 128 m + 64 l + 32 n1 + 16 k1 + 8 i1 + 4 j1 +
     2 m1 + -349525 ≤ 0].
   Curve (n, k)

val alias :
   ∀n, k, i, j, m, l, n1, k1, i1, j1, m1, l1[n + -1024 ≤ 0 ∧
   -n + -i + 512 ≤ 0 ∧ n + -i + -512 ≤ 0 ∧ -i + -j + 256 ≤ 0 ∧
   i + -j + -256 ≤ 0 ∧ -j + -m + 128 ≤ 0 ∧ j + -m + -128 ≤ 0 ∧
   -m + -l + 64 ≤ 0 ∧ m + -l + -64 ≤ 0 ∧ -l + -n1 + 32 ≤ 0 ∧
   l + -n1 + -32 ≤ 0 ∧ -n1 + -k1 + 16 ≤ 0 ∧ n1 + -k1 + -16 ≤ 0 ∧
   -k1 + -i1 + 8 ≤ 0 ∧ k1 + -i1 + -8 ≤ 0 ∧ -i1 + -j1 + 4 ≤ 0 ∧
   i1 + -j1 + -4 ≤ 0 ∧ -j1 + -m1 + 2 ≤ 0 ∧ j1 + -m1 + -2 ≤ 0 ∧
   -m1 + -l1 + 1 ≤ 0 ∧ m1 + -l1 + -1 ≤ 0 ∧
   1024 n + -k + 512 i + 256 j + 128 m + 64 l + 32 n1 + 16 k1 + 8 i1 + 4 j1 +
     2 m1 + 2 l1 + -349526 ≤ 0 ∧
   1024 n + -k + 512 i + 256 j + 128 m + 64 l + 32 n1 + 16 k1 + 8 i1 + 4 j1 +
     2 m1 + -349525 ≤ 0].
   Curve (n, k)

val boundary : Curve (1024, 1048576)

val ray : ∀j[1048576 ≤ j]. Curve (1024, j)

val strip : ∀i, j[i ≤ 4 ∧ 16 ≤ j]. Curve (i, j)
