datatype Nat
datacons Z : Nat
datacons S : Nat ⟶ Nat

datatype StepResult : num * num
datacons B : ∀m, n, k [m≤k ∧ k≤n+1 ∧ k≤max(m+19, 0)]. Num k ⟶ StepResult (m, n)
external let step : ∀m, n [m≤n ∧ n≤max(m+20, 0)]. Num m → Num n → StepResult (m, n) =
  "fun m n -> B (min (n + 1) (max (m + 19) 0))"

let rec climb m = efunction
  | Z -> m
  | S t -> let r = climb m t in
           let B u = step m r in u
