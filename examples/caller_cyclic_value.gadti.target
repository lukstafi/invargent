datatype Probe : num * num * num

datacons Spin : ∀i, j,
   k[i ≤ k + 1].Probe ((3/5) i + (-4/5) j, (4/5) i + (3/5) j, 2 k) ⟶
   Probe (i, j, k)

val probe :
   ∀n, k, i[n ≤ 1 + i ∧ (-336/625) n + (-527/625) k + -16 i ≤ 0 ∧
   (527/625) n + (-336/625) k + -16 i ≤ 0 ∧
   (-527/625) n + (336/625) k + -16 i ≤ 0 ∧
   (336/625) n + (527/625) k + -16 i ≤ 0 ∧
   (-117/125) n + (-44/125) k + -8 i + -1 ≤ 0 ∧
   (-7/25) n + (-24/25) k + -4 i + -1 ≤ 0 ∧
   (3/5) n + (-4/5) k + -2 i + -1 ≤ 0]. Probe (n, k, i)

val alias :
   ∀i, k, n[n ≤ i + 1 ∧ 3 n ≤ 10 i + 4 k + 5 ∧
   0 ≤ 100 i + 24 k + 7 n + 25 ∧ 0 ≤ 10000 i + 527 k + 336 n ∧
   0 ≤ 1000 i + 44 k + 117 n + 125 ∧ 527 n ≤ 10000 i + 336 k ∧
   336 k ≤ 10000 i + 527 n ∧ 527 k + 336 n ≤ 10000 i]. Probe (n, k, i)

val mild : Probe (1, 0, (1/2))

val family : ∀n[(1/16) ≤ n]. Probe (1, 0, n)

val reflected : Probe (-1, 0, (1/16))

val origin : Probe (0, 0, 0)

datatype Branch : num * num * num

datacons Fork : ∀i, j,
   k[i ≤ k + 1].Branch ((3/5) i + (-4/5) j, (4/5) i + (3/5) j, 2 k) *
   Branch ((3/5) i + (4/5) j, (-4/5) i + (3/5) j, 2 k) ⟶ Branch (i, j, k)

val both :
   ∀n, k, i[n ≤ 1 + i ∧ -k + -4 i ≤ 0 ∧
   (-7/25) n + (-24/25) k + -4 i ≤ 0 ∧
   (7/25) n + (-24/25) k + -4 i ≤ 0 ∧
   (-24/25) n + (-7/25) k + -4 i ≤ 0 ∧
   (24/25) n + (-7/25) k + -4 i ≤ 0 ∧ -n + -4 i ≤ 0 ∧
   n + -4 i ≤ 0 ∧ (-24/25) n + (7/25) k + -4 i ≤ 0 ∧
   (24/25) n + (7/25) k + -4 i ≤ 0 ∧
   (-7/25) n + (24/25) k + -4 i ≤ 0 ∧
   (7/25) n + (24/25) k + -4 i ≤ 0 ∧ k + -4 i ≤ 0 ∧
   (3/5) n + (-4/5) k + -2 i + -1 ≤ 0 ∧
   (3/5) n + (4/5) k + -2 i + -1 ≤ 0]. Branch (n, k, i)

val starts : ∀n[(1/4) ≤ n]. Branch (1, 0, n)

datatype Paused : num * num * num

datacons Pause : ∀i, j,
   k[i ≤ k + 1].Paused ((3/5) i + (-4/5) j, (4/5) i + (3/5) j, 2 k) *
   Paused ((4/5) i + (-2/5) j, (2/5) i + (4/5) j, (3/2) k) * Paused (i, j, k)
   ⟶ Paused (i, j, k)

val paused :
   ∀n, k, i[n ≤ 1 + i ∧ (-7/25) n + (-24/25) k + -4 i ≤ 0 ∧
   (24/25) n + (-7/25) k + -4 i ≤ 0 ∧
   (-24/25) n + (7/25) k + -4 i ≤ 0 ∧
   (7/25) n + (24/25) k + -4 i ≤ 0 ∧
   (3/5) n + (-4/5) k + -2 i + -1 ≤ 0]. Paused (n, k, i)

val later : ∀n[(1/4) ≤ n]. Paused (1, 0, n)
