datatype Bounds : num * num

datacons Bounded : ∀i, j, k[k ≤ i ∧ k ≤ j].Num k ⟶ Bounds (i, j)

external val within : ∀i, j[i ≤ j]. Num i → Num j → Bool

val check : ∀i, k, n[min (i, k)≤n]. Bounds (k, i) → Num n → Bool

external val left : Bounds (0, 6)

external val right : Bounds (8, 2)

val uses : (Bool, Bool)
